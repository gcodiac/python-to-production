# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Environment configuration (created during the DevOps learning track)
.env
.env.*
!.env.example

# SQLite database files created by running the app
*.db
*.db-journal

# Test / coverage / lint artefacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Local reference/teaching material - not part of this branch's history
/original/
/learning/

# Generated scan/SBOM output (pip-audit, Trivy, Syft, Grype) - reproducible
# from the commands in SECURITY.md and container-learning/, not committed.
/reports/

# Terraform - state is sensitive and machine-specific, never commit it.
# .terraform.lock.hcl IS committed (pinned provider hashes) - see infra/README.md.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
.terraformrc
terraform.rc

# Kubernetes / Helm
kubeconfig
kubeconfig-*
.rendered/
