# Copy this file to .env and adjust values for your local setup:
#   cp .env.example .env
#
# .env is for local development only and is git-ignored - never commit real
# secrets. In staging/production, set these as real environment variables
# (or via your platform's secret manager for APP_SECRET) instead of a file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./notes.db
LOG_LEVEL=INFO

# Required whenever APP_ENV=production - the app refuses to start in
# production without a real value here. Any non-empty placeholder works for
# local development.
APP_SECRET=replace-with-a-real-secret
