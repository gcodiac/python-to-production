# Copy this file to .env and adjust values for your local setup:
#   cp .env.example .env
#
# .env is for local development only and is git-ignored - never commit real
# secrets. In staging/production, set these as real environment variables
# (or via your platform's secret manager for APP_SECRET) instead of a file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
#
# DATABASE_URL is a SQLAlchemy URL, so this one variable chooses both which
# database engine is used and where it lives. The application supports two
# backends and needs no code change to move between them:
#
#   SQLite      sqlite:///./notes.db
#               A single file. No server to install, nothing to start. This
#               is the default and the fastest way to run the app or its
#               tests - it is a deliberate choice, not a limitation.
#
#   PostgreSQL  postgresql+psycopg://notes:CHANGE-ME@localhost:5432/notes
#               A real client/server database, which is what production
#               deployments normally look like. Requires a PostgreSQL server
#               to be running and reachable at that address.
#
# Never put a real password in this file: it is committed to Git. It is a
# template that gets copied to a git-ignored .env.
DATABASE_URL=sqlite:///./notes.db

# Required whenever APP_ENV=production - the app refuses to start in
# production without a real value here. Any non-empty placeholder works for
# local development.
APP_SECRET=replace-with-a-real-secret
